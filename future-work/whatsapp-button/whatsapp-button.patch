+    </svg>
+  );
+}
+
+export function WhatsAppButton({ tone = "brand" }: { tone?: "green" | "brand" }) {
+  const { t } = useLang();
+  const message = t("Hi MAQAMY, I'd like to know more about your collections.", "Hai MAQAMY, saya ingin tahu lebih lanjut tentang koleksi anda.");
+  const href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
+  const colours = tone === "green" ? "bg-[#25D366] text-white" : "bg-brand-forest text-brand-gold-soft ring-1 ring-brand-gold/50";
+  return (
+    <a
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+      aria-label={t("Chat with MAQAMY on WhatsApp", "Berbual dengan MAQAMY di WhatsApp")}
+      className={`fixed bottom-5 right-5 z-50 flex size-14 items-center justify-center rounded-full shadow-[0_10px_30px_-8px_rgb(0_0_0/0.45)] hover:scale-105 sm:bottom-8 sm:right-8 ${colours}`}
+    >
+      <WhatsAppGlyph className="size-7" />
+    </a>
+  );
+}
